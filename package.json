{
  "name": "@msbel/openclaw-thalamus",
  "version": "0.2.0",
  "description": "Vector packet routing for OpenClaw agents (Phase 3-ready).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "openclaw.plugin.json",
    "encoders/python/**",
    "adapters/*.py",
    "adapters/*.npy",
    "adapters/training_metrics.json",
    "scripts/*.mjs",
    "scripts/*.sh",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "THALAMUS_PHASE3_PLAN.md",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    },
    "./adapters/linearAdapter": {
      "types": "./dist/adapters/linearAdapter.d.ts",
      "import": "./dist/adapters/linearAdapter.js"
    },
    "./encoders/realEncoderClient": {
      "types": "./dist/encoders/realEncoderClient.d.ts",
      "import": "./dist/encoders/realEncoderClient.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./packet": {
      "types": "./dist/packet.d.ts",
      "import": "./dist/packet.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./pipelines/textBusPipeline": {
      "types": "./dist/pipelines/textBusPipeline.d.ts",
      "import": "./dist/pipelines/textBusPipeline.js"
    },
    "./pipelines/thalamusPipeline": {
      "types": "./dist/pipelines/thalamusPipeline.d.ts",
      "import": "./dist/pipelines/thalamusPipeline.js"
    },
    "./pipelines/llmPlanner": {
      "types": "./dist/pipelines/llmPlanner.d.ts",
      "import": "./dist/pipelines/llmPlanner.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    }
  },
  "openclaw": {
    "extensions": [
      "./src/plugin.ts"
    ],
    "runtimeExtensions": [
      "./dist/plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:arm64": "tsc -p tsconfig.json && echo \"ARM64-compatible - pure TS, no native deps except better-sqlite3 (has prebuilds)\"",
    "experiment:plot": "python src/experiments/plot.py",
    "experiment:run": "tsx src/experiments/runExperiment.ts && python src/experiments/plot.py",
    "lint": "eslint . && prettier --check .",
    "prepublishOnly": "npm run build && npm test",
    "telegram:bot": "tsx src/telegram/bot.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "typebox": "^1.1.33",
    "ulid": "^3.0.2"
  },
  "peerDependencies": {
    "lancedb": ">=0.0.1",
    "openclaw": ">=2026.4.26"
  },
  "peerDependenciesMeta": {
    "lancedb": {
      "optional": true
    },
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
