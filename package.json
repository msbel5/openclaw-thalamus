{
  "name": "openclaw-thalamus",
  "version": "1.0.0",
  "description": "Thalamus cognitive hub for OpenClaw: packet handoff, vector memory, routing telemetry, encoder daemon, and multimodal ingest.",
  "type": "module",
  "private": false,
  "bin": {
    "openclaw-thalamus": "./src/cli.js",
    "openclaw-thalamus-mcp": "./src/server.js",
    "openclaw-thalamus-dashboard": "./src/dashboard.js"
  },
  "scripts": {
    "health": "node src/cli.js health",
    "context": "node src/cli.js context",
    "benchmark": "node src/cli.js benchmark",
    "dashboard": "node src/dashboard.js",
    "mcp": "node src/server.js",
    "test": "node --check src/cli.js && node --check src/server.js && node --check src/dashboard.js",
    "pack:check": "npm pack --dry-run --json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msbel5/openclaw-thalamus.git"
  },
